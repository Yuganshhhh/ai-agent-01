# API key for the AI model (Gemini API key from Google AI Studio)
OPENAI_API_KEY=gemini-api-key

# Base URL of the AI provider (OpenAI-compatible endpoint)
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Model name to use
OPENAI_MODEL=gemini-flash-lite-latest

# API key for WeatherAPI (https://www.weatherapi.com), used by the weather tool
WEATHER_API_KEY=weather-api-key
